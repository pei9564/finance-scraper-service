# GitHub Personal Access Token（需要 repo 讀取權限）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Notion Integration Token
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx

# Notion 資料庫 ID（在 Notion 中開啟資料庫頁面，URL 中的 32 位數字串即為 DB ID）
NOTION_DB_REPOSITORIES=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_ACTIVITY_LOGS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_WEEKLY_RADAR=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Bot Token（向 @BotFather 取得）
TELEGRAM_BOT_TOKEN=123456789:xxxxxxxxxxxxxxxxxxxx

# Telegram Chat ID（個人或群組，群組為負數）
TELEGRAM_CHAT_ID=123456789

# 可選：覆蓋預設 lookback 天數
# LOOKBACK_DAYS=7
