# GitHub Personal Access Token（需要 repo 讀取權限）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 本地/內部 LLM gateway（OpenAI 相容），用於 news/paper 逐則中文摘要
# 留空則用 config/repos.yaml 的預設（http://localhost:8000/v1）
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=                       # 留空自動向 /models 偵測
# VLLM_API_KEY=                     # gateway 無驗證可留空

# 可選：覆蓋預設 lookback 天數
# LOOKBACK_DAYS=7

# ── Postgres ───────────────────────────────────────────────────
# 所有 output / 收藏 / 月度摘要都存這裡。請另外起 PG 後填入連線字串。
# Docker 容器內連到 host 上的 PG：
#   PG_DSN=postgresql://user:pass@host.docker.internal:5432/finance_scraper
# 在 host 直接跑：
#   PG_DSN=postgresql://user:pass@localhost:5432/finance_scraper
PG_DSN=postgresql://finance_scraper:finance_scraper@localhost:5432/finance_scraper
